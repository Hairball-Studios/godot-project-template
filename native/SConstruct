#!/usr/bin/env python
"""Build the game's C++ classes against godot-cpp: `mise run build`, or `scons` in this folder.

The library lands in ../bin, where bin/game.gdextension names it. godot-cpp is fetched into
native/godot-cpp by tools/fetch_godot_cpp.py. Options are godot-cpp's: `scons --help` lists them
(`target=template_release`, `arch=x86_64`, `dev_build=yes`).
"""

import platform
import sys

# godot-cpp builds a macOS library for Intel and Apple silicon together unless told otherwise,
# which doubles the compile time: build for this Mac unless `arch=` says otherwise.
if sys.platform == "darwin" and "arch" not in ARGUMENTS:
    ARGUMENTS["arch"] = platform.machine()
# clang-tidy reads this compilation database (tools/clang_tidy.py).
ARGUMENTS.setdefault("compiledb", "yes")

# The Godot minor version the extension is built for: it loads in that version and later ones.
# Keep it in step with mise.toml's Godot pin and bin/game.gdextension.
env = SConscript("godot-cpp/SConstruct", {"api_version": "4.7"})
env.Append(CPPPATH=["src"])
sources = Glob("src/*.cpp")

# The class reference in doc_classes (what the editor's help shows for SnakeBot) is
# compiled into the editor and debug libraries; a release library has no use for it.
if env["target"] in ["editor", "template_debug"]:
    sources.append(env.GodotCPPDocData("gen/doc_data.gen.cpp", source=Glob("doc_classes/*.xml")))

# One file name per platform and target; only the platforms that ship several architectures
# put the architecture in it.
name = "../bin/libgame.{}.{}".format(env["platform"], env["target"])
if env["platform"] != "macos":
    name += "." + env["arch"]
library = env.SharedLibrary(name + env["SHLIBSUFFIX"], source=sources)
Default(library, "compiledb")
