# Layout every editor and tool shares.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.gd]
indent_style = tab
indent_size = 4
max_line_length = 100

[*.{cpp,h}]
indent_style = tab
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.md]
indent_style = space
indent_size = 4
# A trailing pair of spaces is a line break in Markdown.
trim_trailing_whitespace = false
